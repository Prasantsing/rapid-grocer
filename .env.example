# ==========================================
# ZapBasket Environment Configuration
# ==========================================

# Server Listening Port & Domain
PORT=3000
APP_PORT=3000
NODE_ENV=development
APP_DOMAIN=localhost:3000

# API Public Base URL
# - Relative: /api/v1 (recommended when unified server serves both frontend & API)
# - Absolute: http://localhost:3000/api/v1 (for separate dev servers or mobile app)
API_BASE_URL=http://localhost:3000/api/v1

# Allowed Client Origins for CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:4200,http://127.0.0.1:4200,http://localhost:43121,http://127.0.0.1:43121,http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost

# Database Configuration
# MongoDB connection URI (Atlas cloud or local instance)
MONGODB_URI=mongodb+srv://prasantsinghsknscoecomp_db_user:N7FJLnnnkhTzUdIt@prasant.kfrkp3c.mongodb.net/zapbasket?retryWrites=true&w=majority
USE_MEMORY_MONGO=false
SEED_ON_BOOT=true

# Authentication Secrets
JWT_ACCESS_SECRET=zapbasket-dev-access-jwt-secret-change-in-production-2026
JWT_REFRESH_SECRET=zapbasket-dev-refresh-jwt-secret-change-in-production-2026
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies & Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Payment Gateways (Optional)
