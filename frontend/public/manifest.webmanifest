{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "ZapBasket · 12-Minute Grocery Delivery",
  "short_name": "ZapBasket",
  "description": "Order farm-fresh produce, dairy, bakery, beverages, and daily groceries delivered to your doorstep in 12 minutes with ZapBasket.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "portrait-primary",
  "theme_color": "#0e6b4f",
  "background_color": "#f3efe4",
  "categories": ["shopping", "food", "lifestyle"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop Fresh Produce",
      "short_name": "Produce",
      "description": "Farm-fresh fruits, vegetables, and greens",
      "url": "/?category=Produce",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "View Cart",
      "short_name": "Cart",
      "description": "Checkout items in your basket",
      "url": "/cart",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Track Orders",
      "short_name": "Orders",
      "description": "Live GPS delivery partner tracking",
      "url": "/orders",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
