NODE_ENV=development
PORT=43110
MONGODB_URI=mongodb://127.0.0.1:27017/zapbasket
# Set to true to boot an ephemeral MongoDB when no local server is available.
USE_MEMORY_MONGO=false
# Seed catalog, demo users, and sample orders only when the database is empty.
SEED_ON_BOOT=true

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CLIENT_ORIGIN=http://127.0.0.1:43121,http://localhost:43121

# Leave blank to run checkout in demo mode (no live charges).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
